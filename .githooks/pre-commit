#!/bin/bash

# 1. 获取所有已暂存的（Added/Modified）Rust 文件名
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep ".*\.rs$")

# 2. 如果没有 Rust 文件被暂存，直接退出
if [ -z "$STAGED_RS_FILES" ]; then
    exit 0
fi

echo "Formatting staged Rust files..."

# 3. 只对这些文件运行 rustfmt
# 使用 rustfmt 直接处理文件，比 cargo fmt --all 更精准
rustfmt $STAGED_RS_FILES

# 4. 将格式化后的改动重新加入暂存区
# 这样即使你之前只 add 了文件的一部分，格式化后的那部分也会被更新
git add $STAGED_RS_FILES

echo "Done!"